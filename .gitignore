# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Datasets and Archives
/dataset/
/data/
*.zip
*.tar
*.tar.gz
*.tgz

# Source data code must NOT be ignored
!src/data/
!src/data/**
src/data/**/__pycache__/
src/data/**/__pycache__/**

# Precomputed Caches
.cache/
*.cache.pt
data_cache/

# Checkpoints and Output Weights
checkpoints/
*.pth
*.pt

# Training runs and logs
runs/
logs/
wandb/

# OS specific
.DS_Store
Thumbs.db


# Evaluation outputs (large per-detection predictions stay local)
results/**/*.pkl
